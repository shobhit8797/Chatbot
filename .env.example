# Google OAuth (from console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — run `openssl rand -base64 32` to generate
NEXTAUTH_SECRET=
# Required in production; in dev NextAuth auto-detects http://localhost:3000
# NEXTAUTH_URL=https://your-app.vercel.app

# Anthropic API key (from console.anthropic.com)
ANTHROPIC_API_KEY=

# Comma-separated list of allowed email domains (default: petasight.com)
# ALLOWED_EMAIL_DOMAINS=petasight.com
